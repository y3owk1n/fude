# Settings that every tape loads with `Source demos/style.tape`. The theme's
# ground is fude's dark one, so the padding around the editor matches it.
Set Shell "zsh"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 18
Set LineHeight 1.25
Set Width 1400
Set Height 900
Set Padding 20
Set Theme { "name": "fude", "background": "#14161b", "foreground": "#d5d9e0", "cursor": "#d5d9e0", "selection": "#2b3a55", "black": "#14161b", "red": "#e8787a", "green": "#86c58a", "yellow": "#e3b341", "blue": "#7aa7f5", "magenta": "#c49bf2", "cyan": "#6cc8bd", "white": "#d5d9e0", "brightBlack": "#4b5263", "brightRed": "#e8787a", "brightGreen": "#86c58a", "brightYellow": "#e3b341", "brightBlue": "#7aa7f5", "brightMagenta": "#c49bf2", "brightCyan": "#6cc8bd", "brightWhite": "#ffffff" }
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 24
Set MarginFill "#0b0c0f"
Set TypingSpeed 60ms
Set Framerate 20
Set WaitTimeout 240s
Set WaitPattern /❯\s*$/
