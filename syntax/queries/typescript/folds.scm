[
  (function_declaration)
  (generator_function_declaration)
  (class_declaration)
  (method_definition)
  (import_statement)
  (export_statement)
  (statement_block)
  (class_body)
  (object)
  (object_pattern)
  (array)
  (arguments)
  (formal_parameters)
  (switch_body)
  (switch_case)
  (switch_default)
  (template_string)
